# Copy to .env and fill in. .env is gitignored — it exists on this laptop and nowhere else.

# Spotify app client ID. Create an app at https://developer.spotify.com/dashboard
#
# In the app settings, the Redirect URI must be EXACTLY:
#     http://127.0.0.1:8888/callback
#
# Not "localhost" — Spotify stopped accepting it. The literal loopback IP only.
SPOTIFY_CLIENT_ID=

# Absolute path to the label table in the Obsidian vault, forward slashes.
#
#   set, file exists  -> reads the vault directly, nothing stale        (laptop)
#   not set           -> uses the committed copy in src/data/           (Cloudflare)
#   set, file missing -> sync fails and the build stops                 (a typo here)
#
# The third case is deliberate. A mistyped path that silently fell back would
# build yesterday's shelf and look like it worked.
ALBUM_LABELS=C:/Dev/Atlas/3-projects/albums.md
