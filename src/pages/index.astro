---
import catalogue from '../../data/albums.json';
import labels from '../data/labels.json';
import { GENRES, OTHER } from '../../scripts/genre.mjs';

const albums = catalogue
  .filter((a) => labels[a.id])
  .map((a) => ({ ...a, ...labels[a.id] }));

// Genre is set by machine (npm run genres, into the label table), states by
// hand. Each list only shows when something on the shelf has one, so the page
// works without either.
const hasGenres = albums.some((a) => a.genre);
const genreOf = (a) => a.genre ?? OTHER;
const genres = [...GENRES.map((g) => g.name), OTHER]
  .map((name) => ({ name, count: albums.filter((a) => genreOf(a) === name).length }))
  .filter((g) => hasGenres && g.count > 0);

const stateCount = new Map();
for (const a of albums) for (const s of a.states ?? []) stateCount.set(s, (stateCount.get(s) ?? 0) + 1);
const states = [...stateCount]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'nl'))
  .map(([name, count]) => ({ name, count }));

const unlabelled = catalogue.length - albums.length;
const isSample = catalogue.some((a) => String(a.id).startsWith('sample-'));
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>albums — bram delisse</title>
    <meta
      name="description"
      content="Mijn albumcollectie, georganiseerd op aandacht en energie, elk met een bijpassende kleur."
    />
    <meta name="theme-color" content="#FCFCFA" />
  </head>

  <body>
    <main>
      <header>
        <h1><span class="marker">albums</span></h1>
        <p class="lede">
          Welkom bij mijn album collectie. De albums staan georganiseerd op aandacht en energie en hebben een bijpassende kleur. Exploreer, en veel luisterplezier!
        </p>
        <p class="lede sub">Wijs een stip aan om het album te zien.</p>
      </header>

      <div class="layout">
        <div class="plane-wrap">
          <span class="axis-y-label">aandacht</span>

          <div class="plane-rows">
            <span class="tick top">eist alle aandacht</span>

            <div class="plane" id="plane">
              <div class="crosshair"></div>
              {
                albums.map((a) => (
                  <button
                    type="button"
                    class="dot"
                    style={`left:${a.energy}%;bottom:${a.attention}%;--dot:${a.colour}`}
                    data-artist={a.artist}
                    data-album={a.album}
                    data-year={a.year}
                    data-cover={a.cover}
                    data-gem={a.gem ? '1' : ''}
                    data-review={a.review ?? ''}
                    data-url={a.url ?? ''}
                    data-genre={hasGenres ? genreOf(a) : ''}
                    data-states={(a.states ?? []).join(',')}
                    aria-label={`${a.artist} — ${a.album}`}
                  />
                ))
              }
            </div>

            <span class="tick bottom">je vergeet dat het aanstaat</span>
          </div>

          <div class="axis-x">
            <span class="tick">brengt je in slaap</span>
            <span class="axis-x-label">energie</span>
            <span class="tick">brengt je naar de maan</span>
          </div>
        </div>

        <div class="side">
        <aside id="panel" class="panel is-empty">
          <div class="cover-wrap">
            <div class="cover" id="cover"></div>
            <svg class="gem-sticker" id="gemSticker" viewBox="0 0 56 44" aria-hidden="true">
              <path
                d="M4 16 L15 4 L41 4 L52 16 L28 40 Z"
                fill="#cfe3ef"
                stroke="#fcfcfa"
                stroke-width="4.5"
                stroke-linejoin="round"
                paint-order="stroke"
              />
              <path d="M4 16 L15 4 L20 16 Z" fill="#eaf4fa" />
              <path d="M36 16 L41 4 L52 16 Z" fill="#eaf4fa" />
              <path
                d="M4 16 L15 4 L41 4 L52 16 L28 40 Z"
                fill="none"
                stroke="#3f6b86"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
              <path
                d="M4 16 H52 M15 4 L20 16 M41 4 L36 16 M20 16 L28 40 M36 16 L28 40"
                fill="none"
                stroke="#3f6b86"
                stroke-opacity="0.5"
                stroke-width="1.1"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <p class="artist" id="artist">—</p>
          <p class="album" id="album">Wijs een stip aan.</p>
          <p class="year" id="year"></p>
          <p class="review" id="review"></p>
          <a class="spotify" id="spotify" href="#" target="_blank" rel="noopener" hidden
            >open in Spotify</a
          >
        </aside>

        {
          (states.length > 0 || genres.length > 0) && (
            <div class="filters">
              {states.length > 0 && (
                <fieldset class="filter" id="stateFilter">
                  <legend>states</legend>
                  <div class="chips">
                    {states.map((s) => (
                      <button type="button" class="chip" aria-pressed="false" data-state={s.name}>
                        {s.name}
                      </button>
                    ))}
                  </div>
                </fieldset>
              )}
              {genres.length > 0 && (
                <fieldset class="filter" id="genreFilter">
                  <legend>genre</legend>
                  <ul class="genres">
                    {genres.map((g) => (
                      <li>
                        <label>
                          <input type="checkbox" value={g.name} checked />
                          <span>{g.name}</span>
                          <span class="n">{g.count}</span>
                        </label>
                        <button type="button" class="only" data-only={g.name}>alleen</button>
                      </li>
                    ))}
                  </ul>
                  <button type="button" class="all" id="genreAll" hidden>alles tonen</button>
                </fieldset>
              )}
            </div>
          )
        }
        </div>
      </div>

      <footer>
        <p>
          {albums.length} gelabeld{unlabelled > 0 && <> · {unlabelled} nog niet</>}
          {isSample && <> · <em>voorbeelddata</em></>}
          <span id="visible"></span>
        </p>
      </footer>
    </main>

    <script is:inline>
      const panel = document.getElementById('panel');
      const fields = {
        artist: document.getElementById('artist'),
        album: document.getElementById('album'),
        year: document.getElementById('year'),
        review: document.getElementById('review'),
        cover: document.getElementById('cover'),
        spotify: document.getElementById('spotify'),
      };

      function show(dot) {
        panel.classList.remove('is-empty');
        fields.artist.textContent = dot.dataset.artist;
        fields.album.textContent = dot.dataset.album;
        fields.year.textContent = dot.dataset.year || '';
        fields.review.textContent = dot.dataset.review || '';
        fields.cover.style.backgroundImage = dot.dataset.cover
          ? `url("${dot.dataset.cover}")`
          : 'none';
        fields.cover.style.backgroundColor = getComputedStyle(dot).getPropertyValue('--dot');
        // A gem is only visible once you open the album, never on the plane.
        // classList, not .hidden: SVG elements have no hidden property.
        document.getElementById('gemSticker').classList.toggle('is-on', dot.dataset.gem === '1');
        // Spotify lives here, under the album, and nowhere else. The dot itself
        // does nothing on click — that gesture is reserved for zooming in later.
        fields.spotify.href = dot.dataset.url || '#';
        fields.spotify.hidden = !dot.dataset.url;
      }

      const dots = [...document.querySelectorAll('.dot')];
      for (const dot of dots) {
        dot.addEventListener('pointerenter', () => show(dot));
        dot.addEventListener('focus', () => show(dot));
      }

      // Filters narrow the plane; they never rearrange it. An album that does
      // not match stays where it is, greyed out and inert, so you still see
      // where the rest of the shelf sits. Every genre starts ticked and no state
      // starts pressed — so by default everything is lit.
      const genreBoxes = [...document.querySelectorAll('#genreFilter input')];
      const stateChips = [...document.querySelectorAll('#stateFilter .chip')];
      const genreAll = document.getElementById('genreAll');
      const visible = document.getElementById('visible');

      function applyFilters() {
        const genres = new Set(genreBoxes.filter((b) => b.checked).map((b) => b.value));
        const states = stateChips
          .filter((c) => c.getAttribute('aria-pressed') === 'true')
          .map((c) => c.dataset.state);
        let shown = 0;
        for (const dot of dots) {
          const own = dot.dataset.states ? dot.dataset.states.split(',') : [];
          const on =
            (genreBoxes.length === 0 || genres.has(dot.dataset.genre)) &&
            (states.length === 0 || states.some((s) => own.includes(s)));
          dot.classList.toggle('is-off', !on);
          // Out of the tab order too, not only out of reach of the pointer.
          dot.tabIndex = on ? 0 : -1;
          dot.setAttribute('aria-hidden', on ? 'false' : 'true');
          if (on) shown++;
        }
        visible.textContent = shown === dots.length ? '' : ` · ${shown} geselecteerd`;
        if (genreAll) genreAll.hidden = genreBoxes.every((b) => b.checked);
      }

      for (const box of genreBoxes) box.addEventListener('change', applyFilters);
      for (const chip of stateChips) {
        chip.addEventListener('click', () => {
          const on = chip.getAttribute('aria-pressed') !== 'true';
          chip.setAttribute('aria-pressed', on ? 'true' : 'false');
          applyFilters();
        });
      }
      for (const only of document.querySelectorAll('#genreFilter .only')) {
        only.addEventListener('click', () => {
          for (const box of genreBoxes) box.checked = box.value === only.dataset.only;
          applyFilters();
        });
      }
      genreAll?.addEventListener('click', () => {
        for (const box of genreBoxes) box.checked = true;
        applyFilters();
      });
    </script>

    <style>
      :root {
        --paper: #fcfcfa;
        --ink: #16181c;
        --sunflower: #f2b705;
        --marker: #ffd84d;
        --rule: rgba(22, 24, 28, 0.14);
      }

      * {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 3rem 1.25rem 4rem;
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 6vw, 2.75rem);
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      /* Yellow is the trace of a hand: never text, never background. */
      .marker {
        background: linear-gradient(var(--marker), var(--marker)) no-repeat;
        background-size: 100% 0.42em;
        background-position: 0 78%;
        padding: 0 0.1em;
      }

      .lede {
        margin: 0.75rem 0 0;
        max-width: 46ch;
        color: rgba(22, 24, 28, 0.72);
      }

      .lede.sub {
        font-size: 0.9rem;
        color: rgba(22, 24, 28, 0.5);
      }

      .review {
        margin: 0.55rem 0 0;
        font-size: 0.95rem;
        line-height: 1.45;
        font-style: italic;
        color: rgba(22, 24, 28, 0.78);
      }

      .layout {
        display: flex;
        flex-wrap: wrap;
        gap: 2.5rem;
        align-items: flex-start;
        margin-top: 2.5rem;
      }

      .plane-wrap {
        flex: 1 1 22rem;
        min-width: 0;
        display: grid;
        grid-template-columns: 1.4rem 1fr;
        gap: 0.5rem;
      }

      .axis-y-label {
        grid-row: 1;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        justify-self: center;
        align-self: center;
      }

      .axis-y-label,
      .axis-x-label {
        font-size: 0.78rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(22, 24, 28, 0.62);
      }

      .plane-rows {
        display: grid;
        gap: 0.4rem;
      }

      .tick {
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        color: rgba(22, 24, 28, 0.5);
      }

      .tick.top,
      .tick.bottom {
        justify-self: start;
      }

      .plane {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        border: 1px solid var(--rule);
        border-radius: 2px;
        background: #fff;
      }

      .crosshair {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(var(--rule), var(--rule)) no-repeat 50% 0 / 1px 100%,
          linear-gradient(var(--rule), var(--rule)) no-repeat 0 50% / 100% 1px;
        pointer-events: none;
      }

      .axis-x {
        grid-column: 2;
        display: flex;
        gap: 0.75rem;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 0.15rem;
      }

      /* A button, not a link: pointing at it is the whole gesture. Clicking is
         deliberately inert, so the plane can later zoom in on a neighbourhood. */
      .dot {
        position: absolute;
        width: 1.15rem;
        height: 1.15rem;
        margin: 0 0 -0.575rem -0.575rem;
        padding: 0;
        border: 0;
        border-radius: 50%;
        appearance: none;
        font: inherit;
        cursor: default;
        background: var(--dot);
        /* A ring, so a near-white colour is still a dot and not a hole. */
        box-shadow: inset 0 0 0 1px rgba(22, 24, 28, 0.22);
        z-index: 1;
        transition:
          transform 0.12s ease,
          background-color 0.2s ease;
      }

      /* Not matching the filters: still on the map, but grey and untouchable. */
      .dot.is-off {
        background: rgba(22, 24, 28, 0.1);
        box-shadow: none;
        pointer-events: none;
        z-index: 0;
      }

      .dot:hover,
      .dot:focus-visible {
        transform: scale(1.5);
        outline: none;
        box-shadow:
          inset 0 0 0 1px rgba(22, 24, 28, 0.3),
          0 0 0 3px var(--marker);
        z-index: 2;
      }

      .side {
        flex: 0 1 15rem;
        min-width: 0;
      }

      .panel {
        /* Neutral, so that on this page yellow means exactly one thing: a gem. */
        border-top: 1px solid var(--rule);
        padding-top: 1rem;
      }

      .cover {
        width: 100%;
        aspect-ratio: 1;
        background: rgba(22, 24, 28, 0.05) center / cover no-repeat;
        border-radius: 2px;
      }

      .cover-wrap {
        position: relative;
        width: 100%;
        max-width: 13rem;
        margin-bottom: 0.9rem;
      }

      /* One of the gems — a sticker stuck on the corner, not a frame.
         Only here: the plane stays about colour and position, nothing else. */
      .gem-sticker {
        display: none;
        position: absolute;
        top: -0.75rem;
        right: -0.9rem;
        width: 3.6rem;
        height: auto;
        transform: rotate(14deg);
        filter: drop-shadow(0 1px 2px rgba(22, 24, 28, 0.3));
        pointer-events: none;
      }
      .gem-sticker.is-on {
        display: block;
      }

      .panel p {
        margin: 0 0 0.2rem;
      }

      .artist {
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(22, 24, 28, 0.62);
      }

      .album {
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.25;
      }

      .year,
      .hint {
        font-size: 0.82rem;
        color: rgba(22, 24, 28, 0.5);
      }

      .hint {
        margin-top: 0.9rem;
      }

      /* Quiet on purpose: the shelf is for choosing, Spotify is for playing. */
      .spotify {
        display: inline-block;
        margin-top: 0.7rem;
        font-size: 0.78rem;
        letter-spacing: 0.02em;
        color: rgba(22, 24, 28, 0.42);
        text-decoration: none;
        border-bottom: 1px solid rgba(22, 24, 28, 0.18);
      }

      .spotify:hover,
      .spotify:focus-visible {
        color: rgba(22, 24, 28, 0.78);
        border-bottom-color: rgba(22, 24, 28, 0.45);
        outline: none;
      }

      .is-empty .cover,
      .is-empty .artist,
      .is-empty .hint {
        opacity: 0.35;
      }

      /* ------------------------------ filters ------------------------------ */

      .filters {
        margin-top: 2rem;
        display: grid;
        gap: 1.5rem;
      }

      .filter {
        margin: 0;
        padding: 0;
        border: 0;
        min-width: 0;
      }

      .filter legend {
        padding: 0;
        margin-bottom: 0.5rem;
        font-size: 0.72rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(22, 24, 28, 0.5);
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }

      /* Pressed is ink, not yellow: on this page yellow means a gem. */
      .chip {
        font: inherit;
        font-size: 0.82rem;
        padding: 0.15rem 0.65rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: transparent;
        color: rgba(22, 24, 28, 0.72);
        cursor: pointer;
      }

      .chip:hover {
        color: var(--ink);
        border-color: rgba(22, 24, 28, 0.35);
      }

      .chip[aria-pressed='true'] {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--paper);
      }

      .genres {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.85rem;
      }

      .genres li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .genres label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.1rem 0;
        cursor: pointer;
      }

      .genres input {
        margin: 0;
        accent-color: var(--ink);
      }

      .genres .n {
        font-size: 0.75rem;
        color: rgba(22, 24, 28, 0.42);
        font-variant-numeric: tabular-nums;
      }

      .only,
      .all {
        font: inherit;
        font-size: 0.72rem;
        padding: 0;
        border: 0;
        background: none;
        color: rgba(22, 24, 28, 0.42);
        cursor: pointer;
        border-bottom: 1px solid transparent;
      }

      /* "alleen" waits in the margin until you point at the row. */
      .only {
        opacity: 0;
      }

      .genres li:hover .only,
      .only:focus-visible {
        opacity: 1;
      }

      .only:hover,
      .all:hover,
      .only:focus-visible,
      .all:focus-visible {
        color: var(--ink);
        border-bottom-color: rgba(22, 24, 28, 0.45);
        outline: none;
      }

      .all {
        margin-top: 0.5rem;
      }

      @media (hover: none) {
        .only {
          opacity: 1;
        }
      }

      footer {
        margin-top: 3rem;
        font-size: 0.82rem;
        color: rgba(22, 24, 28, 0.5);
      }

      @media (max-width: 640px) {
        main {
          padding-top: 2rem;
        }
        /* The axis ends say it well enough on their own down here. */
        .axis-x-label {
          display: none;
        }
        .tick {
          font-size: 0.68rem;
        }
        .layout {
          gap: 1.75rem;
        }
        .side {
          flex-basis: 100%;
        }
        .panel {
          display: grid;
          grid-template-columns: 5rem 1fr;
          gap: 0 1rem;
          align-items: start;
        }
        .cover-wrap {
          grid-row: 1 / span 4;
          margin-bottom: 0;
        }
        .gem-sticker {
          width: 2.7rem;
          top: -0.55rem;
          right: -0.65rem;
        }
        .spotify {
          grid-column: 2;
          justify-self: start;
        }
      }
    </style>
  </body>
</html>
